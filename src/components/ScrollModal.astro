---
// The unrolling papyrus. Clicking a scroll card fetches that project's page and shows its
// [data-scroll-content] here; without JS the card just navigates to the page.
---

<dialog class="scroll-modal" aria-label="Project scroll">
  <div class="scroll">
    <span class="rod" aria-hidden="true"></span>
    <div class="sheet">
      <div class="inner">
        <button class="close" type="button" aria-label="Roll up the scroll">×</button>
        <div class="content" data-target></div>
      </div>
    </div>
    <span class="rod" aria-hidden="true"></span>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".scroll-modal")!;
  const target = dialog.querySelector<HTMLElement>("[data-target]")!;
  const cache = new Map<string, string>();

  async function load(slug: string) {
    if (cache.has(slug)) return cache.get(slug)!;
    const res = await fetch(`/projects/${slug}/`);
    const doc = new DOMParser().parseFromString(await res.text(), "text/html");
    const html = doc.querySelector("[data-scroll-content]")?.innerHTML ?? "";
    cache.set(slug, html);
    return html;
  }

  function close() {
    dialog.classList.remove("open");
    window.setTimeout(() => dialog.close(), 450);
  }

  document.addEventListener("click", async (e) => {
    const card = (e.target as HTMLElement).closest<HTMLAnchorElement>("[data-scroll-open]");
    if (!card || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    try {
      const html = await load(card.dataset.scrollOpen!);
      if (!html) throw new Error("empty");
      target.innerHTML = html;
    } catch {
      window.location.href = card.href; // fall back to the full page
      return;
    }
    dialog.showModal();
    dialog.querySelector(".inner")!.scrollTop = 0;
    requestAnimationFrame(() => dialog.classList.add("open"));
    document.dispatchEvent(new CustomEvent("scroll-opened", { detail: card.dataset.scrollOpen }));
  });

  dialog.querySelector(".close")!.addEventListener("click", close);
  dialog.addEventListener("cancel", (e) => {
    e.preventDefault();
    close();
  });
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) close();
  });
</script>

<style>
  .scroll-modal {
    width: min(860px, 94vw);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .scroll-modal::backdrop {
    background: rgba(11, 34, 56, 0.72);
    backdrop-filter: blur(3px);
  }
  .scroll {
    display: flex;
    flex-direction: column;
  }
  .rod {
    position: relative;
    z-index: 2;
    height: 26px;
    margin-inline: -14px;
    border-radius: 13px;
    background: linear-gradient(180deg, #b07c3e, #6e4317 55%, #3f240b);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
  }
  .rod::before,
  .rod::after {
    content: "";
    position: absolute;
    top: -6px;
    width: 20px;
    height: 38px;
    border-radius: 8px;
    background: linear-gradient(180deg, #f0cf7c, #9a6f22);
  }
  .rod::before {
    left: -14px;
  }
  .rod::after {
    right: -14px;
  }
  /* unroll: the sheet grows from 0 to full height */
  .sheet {
    display: grid;
    grid-template-rows: 0fr;
    margin-block: -8px;
    transition: grid-template-rows 0.6s cubic-bezier(0.3, 0.8, 0.3, 1);
  }
  .open .sheet {
    grid-template-rows: 1fr;
  }
  .inner {
    position: relative;
    min-height: 0;
    max-height: calc(100vh - 140px);
    overflow: auto;
    padding: 0 clamp(20px, 5vw, 56px);
    background:
      linear-gradient(90deg, rgba(150, 105, 40, 0.22), transparent 6%, transparent 94%, rgba(150, 105, 40, 0.22)),
      var(--parchment);
    scrollbar-color: var(--parchment-dark) transparent;
  }
  .content {
    padding-block: 40px 48px;
  }
  .close {
    position: sticky;
    top: 12px;
    float: right;
    margin: 12px -24px 0 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--parchment-dark);
    background: #fff6df;
    color: #3a2a16;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover {
    background: var(--gold-light);
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
</style>
