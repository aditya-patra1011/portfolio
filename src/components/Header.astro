---
import { site } from "../data/site";

const nav = [
  { href: "/projects/", label: "projects" },
  { href: "/about/", label: "about" },
  { href: `mailto:${site.links.email}`, label: "contact" },
];
const path = Astro.url.pathname;
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Home">
      <span class="prompt">~/</span>aditya<span class="long">_patra</span><span class="caret" aria-hidden="true"></span>
    </a>
    <nav aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
            <span class="dot">./</span>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(3, 6, 4, 0.78);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    gap: 16px;
  }
  .brand {
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .prompt {
    color: var(--neon);
    text-shadow: var(--glow);
  }
  .brand .caret {
    width: 0.55em;
    height: 1em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 28px);
    font-size: 0.85rem;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .dot {
    color: var(--ink-3);
  }
  nav a[aria-current="page"] {
    color: var(--neon);
    text-shadow: var(--glow);
  }
  nav a[aria-current="page"] .dot {
    color: var(--neon-dim);
  }
  @media (max-width: 520px) {
    .long,
    .dot {
      display: none;
    }
  }
</style>
