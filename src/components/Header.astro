---
import { site } from "../data/site";

const prefix = Astro.url.pathname === "/" ? "" : "/";
const nav = [
  { href: `${prefix}#entrance`, label: "Entrance" },
  { href: `${prefix}#oracle`, label: "Oracle" },
  { href: `${prefix}#labours`, label: "Labours" },
  { href: `${prefix}#gifts`, label: "Gifts" },
  { href: `${prefix}#treasury`, label: "Treasury" },
  { href: `${prefix}#altar`, label: "Altar" },
];
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Home">
      <svg class="laurel" viewBox="0 0 64 40" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M22 36C10 30 6 18 10 6" />
          <path d="M42 36c12-6 16-18 12-30" />
        </g>
        <g fill="currentColor">
          <ellipse cx="9" cy="12" rx="2.4" ry="5" transform="rotate(-30 9 12)" />
          <ellipse cx="9" cy="22" rx="2.4" ry="5" transform="rotate(-60 9 22)" />
          <ellipse cx="15" cy="31" rx="2.4" ry="5" transform="rotate(-75 15 31)" />
          <ellipse cx="55" cy="12" rx="2.4" ry="5" transform="rotate(30 55 12)" />
          <ellipse cx="55" cy="22" rx="2.4" ry="5" transform="rotate(60 55 22)" />
          <ellipse cx="49" cy="31" rx="2.4" ry="5" transform="rotate(75 49 31)" />
        </g>
        <text x="32" y="26" text-anchor="middle" font-family="Cinzel, serif" font-size="15" font-weight="700" fill="currentColor">AP</text>
      </svg>
      <span>Aditya Patra</span>
    </a>

    <nav id="menu" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/projects/" class="all">All scrolls</a>
    </nav>

    <a class="btn gold cv" href={site.links.resume}>Résumé</a>

    <button class="toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="meander" aria-hidden="true"></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".header")!;
  const btn = header.querySelector<HTMLButtonElement>(".toggle")!;
  btn.addEventListener("click", () => {
    const open = header.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(open));
  });
  header.querySelectorAll("nav a").forEach((a) =>
    a.addEventListener("click", () => {
      header.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    }),
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(244, 239, 228, 0.95);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 18px rgba(60, 45, 20, 0.12);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 22px;
    height: 70px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .laurel {
    width: 52px;
    height: 34px;
    color: var(--gold);
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    margin-left: auto;
  }
  nav a {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink-2);
  }
  nav a:hover {
    color: var(--gold);
  }
  .all {
    color: var(--sea);
  }
  .cv {
    padding: 8px 16px;
    font-size: 0.75rem;
  }
  .toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .toggle span {
    width: 24px;
    height: 2px;
    background: var(--ink);
  }
  @media (max-width: 1120px) {
    .toggle {
      display: flex;
    }
    .cv {
      margin-left: auto;
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 6px var(--gutter) 14px;
      background: var(--marble);
      box-shadow: 0 12px 24px rgba(60, 45, 20, 0.15);
    }
    .header.open nav {
      display: flex;
    }
    nav a {
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 480px) {
    .logo span {
      display: none;
    }
  }
</style>
