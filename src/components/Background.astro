---
// Fixed, decorative background: a drifting network graph with data packets running along its
// edges, a radar sweep and orbit rings, drawn on one canvas. CSS layers add the grid, scanlines and vignette.
---

<div class="bg" aria-hidden="true">
  <div class="grid"></div>
  <canvas id="net"></canvas>
  <div class="scan"></div>
  <div class="vignette"></div>
</div>

<script>
  const canvas = document.getElementById("net") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const NEON = "57, 255, 143";
  const CYAN = "70, 232, 255";
  const LINK = 150; // max edge length in px

  type Node = { x: number; y: number; vx: number; vy: number; r: number; hub: boolean };
  type Packet = { a: number; b: number; t: number; speed: number };

  let w = 0;
  let h = 0;
  let dpr = 1;
  let nodes: Node[] = [];
  let packets: Packet[] = [];
  let mouse = { x: -9999, y: -9999 };
  let frame = 0;
  let raf = 0;

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = `${w}px`;
    canvas.style.height = `${h}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.min(90, Math.max(28, Math.round((w * h) / 16000)));
    nodes = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.22,
      vy: (Math.random() - 0.5) * 0.22,
      r: Math.random() * 1.2 + 0.8,
      hub: Math.random() < 0.12,
    }));
    packets = [];
  }

  function spawnPacket() {
    const a = Math.floor(Math.random() * nodes.length);
    let best = -1;
    let bestD = Infinity;
    for (let i = 0; i < nodes.length; i++) {
      if (i === a) continue;
      const d = Math.hypot(nodes[i].x - nodes[a].x, nodes[i].y - nodes[a].y);
      if (d < LINK && d < bestD && Math.random() < 0.7) {
        best = i;
        bestD = d;
      }
    }
    if (best >= 0) packets.push({ a, b: best, t: 0, speed: 0.008 + Math.random() * 0.012 });
  }

  function drawRadar(cx: number, cy: number, R: number, angle: number) {
    ctx.save();
    ctx.translate(cx, cy);
    ctx.strokeStyle = `rgba(${NEON}, 0.07)`;
    ctx.lineWidth = 1;
    for (let i = 1; i <= 4; i++) {
      ctx.beginPath();
      ctx.arc(0, 0, (R * i) / 4, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.beginPath();
    ctx.moveTo(-R, 0);
    ctx.lineTo(R, 0);
    ctx.moveTo(0, -R);
    ctx.lineTo(0, R);
    ctx.stroke();
    // tick marks
    for (let i = 0; i < 72; i++) {
      const a = (i / 72) * Math.PI * 2;
      const len = i % 6 === 0 ? 10 : 4;
      ctx.beginPath();
      ctx.moveTo(Math.cos(a) * R, Math.sin(a) * R);
      ctx.lineTo(Math.cos(a) * (R - len), Math.sin(a) * (R - len));
      ctx.stroke();
    }
    // sweep with a fading trail
    const grad = ctx.createConicGradient(angle - 0.9, 0, 0);
    grad.addColorStop(0, `rgba(${NEON}, 0)`);
    grad.addColorStop(0.14, `rgba(${NEON}, 0.12)`);
    grad.addColorStop(0.1433, `rgba(${NEON}, 0)`);
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(0, 0, R, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = `rgba(${NEON}, 0.35)`;
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.lineTo(Math.cos(angle) * R, Math.sin(angle) * R);
    ctx.stroke();
    ctx.restore();
  }

  function drawOrbits(cx: number, cy: number, t: number) {
    const rings = [
      { rx: 260, ry: 90, rot: -0.35, speed: 0.0016, color: NEON },
      { rx: 340, ry: 130, rot: 0.2, speed: -0.0011, color: CYAN },
    ];
    for (const o of rings) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(o.rot);
      ctx.setLineDash([2, 6]);
      ctx.strokeStyle = `rgba(${o.color}, 0.12)`;
      ctx.beginPath();
      ctx.ellipse(0, 0, o.rx, o.ry, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);
      const a = t * o.speed;
      const x = Math.cos(a) * o.rx;
      const y = Math.sin(a) * o.ry;
      ctx.fillStyle = `rgba(${o.color}, 0.8)`;
      ctx.shadowColor = `rgba(${o.color}, 1)`;
      ctx.shadowBlur = 10;
      ctx.fillRect(x - 2, y - 2, 4, 4);
      ctx.restore();
    }
  }

  function draw() {
    ctx.clearRect(0, 0, w, h);
    const t = frame;

    // diagrams sit in the upper right, behind the hero, and scale down on small screens
    const s = Math.min(1, w / 1300);
    drawRadar(w * 0.82, h * 0.3, 210 * s + 60, (t * 0.012) % (Math.PI * 2));
    ctx.save();
    ctx.translate(w * 0.82, h * 0.3);
    ctx.scale(s, s);
    drawOrbits(0, 0, t);
    ctx.restore();

    // move nodes
    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;
      if (n.x < -20) n.x = w + 20;
      if (n.x > w + 20) n.x = -20;
      if (n.y < -20) n.y = h + 20;
      if (n.y > h + 20) n.y = -20;
    }

    // edges
    ctx.lineWidth = 1;
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < LINK) {
          ctx.strokeStyle = `rgba(${NEON}, ${0.16 * (1 - d / LINK)})`;
          ctx.beginPath();
          // right-angle "circuit" routing for hubs, straight lines otherwise
          if (a.hub || b.hub) {
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, a.y);
            ctx.lineTo(b.x, b.y);
          } else {
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
          }
          ctx.stroke();
        }
      }
      // pointer links
      const dm = Math.hypot(a.x - mouse.x, a.y - mouse.y);
      if (dm < 180) {
        ctx.strokeStyle = `rgba(${NEON}, ${0.45 * (1 - dm / 180)})`;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
    }

    // nodes
    for (const n of nodes) {
      if (n.hub) {
        ctx.strokeStyle = `rgba(${NEON}, 0.55)`;
        ctx.strokeRect(n.x - 3.5, n.y - 3.5, 7, 7);
        ctx.fillStyle = `rgba(${NEON}, 0.9)`;
        ctx.fillRect(n.x - 1, n.y - 1, 2, 2);
      } else {
        ctx.fillStyle = `rgba(${NEON}, 0.5)`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // packets
    if (frame % 14 === 0 && packets.length < 18) spawnPacket();
    ctx.shadowColor = `rgba(${NEON}, 1)`;
    ctx.shadowBlur = 12;
    ctx.fillStyle = `rgba(${NEON}, 0.95)`;
    packets = packets.filter((p) => {
      p.t += p.speed;
      const a = nodes[p.a];
      const b = nodes[p.b];
      if (!a || !b || p.t >= 1 || Math.hypot(a.x - b.x, a.y - b.y) > LINK) return false;
      ctx.fillRect(a.x + (b.x - a.x) * p.t - 1.5, a.y + (b.y - a.y) * p.t - 1.5, 3, 3);
      return true;
    });
    ctx.shadowBlur = 0;
  }

  function loop() {
    frame++;
    draw();
    raf = requestAnimationFrame(loop);
  }

  resize();
  if (reduce) {
    draw();
  } else {
    loop();
    document.addEventListener("visibilitychange", () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) loop();
    });
    window.addEventListener("pointermove", (e) => {
      mouse = { x: e.clientX, y: e.clientY };
    });
    document.addEventListener("pointerleave", () => {
      mouse = { x: -9999, y: -9999 };
    });
  }

  let resizeTimer = 0;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      resize();
      if (reduce) draw();
    }, 150);
  });
</script>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 80% 20%, rgba(57, 255, 143, 0.07), transparent 65%),
      radial-gradient(ellipse 60% 50% at 10% 90%, rgba(70, 232, 255, 0.04), transparent 60%),
      var(--bg);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(57, 255, 143, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57, 255, 143, 0.045) 1px, transparent 1px),
      linear-gradient(rgba(57, 255, 143, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57, 255, 143, 0.02) 1px, transparent 1px);
    background-size:
      96px 96px,
      96px 96px,
      24px 24px,
      24px 24px;
    mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 85%);
  }
  canvas {
    position: absolute;
    inset: 0;
  }
  .scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0,
      rgba(0, 0, 0, 0) 2px,
      rgba(0, 0, 0, 0.22) 3px
    );
  }
  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.7) 100%);
  }
</style>
