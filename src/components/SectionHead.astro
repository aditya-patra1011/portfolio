---
// Section title block: green eyebrow, big title with one green word, outlined ghost word behind,
// and an optional intro paragraph on the right with the green rule.
interface Props {
  eyebrow: string;
  title: string;
  accent: string; // the part of the title shown in green
  ghost: string;
  intro?: string;
}

const { eyebrow, title, accent, ghost, intro } = Astro.props;
const i = title.lastIndexOf(accent);
const before = i >= 0 ? title.slice(0, i) : title;
const after = i >= 0 ? title.slice(i + accent.length) : "";
---

<div class:list={["head", { split: intro }]} data-reveal>
  <div class="titles">
    <span class="ghost" aria-hidden="true">{ghost}</span>
    <span class="eyebrow">{eyebrow}</span>
    <h2>{before}{i >= 0 && <span class="green">{accent}</span>}{after}</h2>
  </div>
  {intro && <p class="lead-rule">{intro}</p>}
</div>

<style>
  .head {
    display: grid;
    gap: 24px 60px;
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 64px);
  }
  .split {
    grid-template-columns: 1fr 1fr;
  }
  .titles {
    position: relative;
    padding-top: 18px;
  }
  .ghost {
    position: absolute;
    left: 0;
    top: -0.32em;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 9vw, 6.6rem);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.07);
    pointer-events: none;
    user-select: none;
  }
  .eyebrow,
  h2 {
    position: relative;
  }
  h2 {
    font-size: clamp(2rem, 4.4vw, 3.1rem);
  }
  .lead-rule {
    max-width: 46ch;
  }
  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
