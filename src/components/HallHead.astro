---
// Heading for each hall of the temple: a pediment with the hall's numeral, its Greek name and title.
interface Props {
  numeral: string; // e.g. "Hall I"
  greek: string; // e.g. "ΜΑΝΤΕΙΟΝ"
  title: string;
  intro?: string;
  tone?: "light" | "dark";
}

const { numeral, greek, title, intro, tone = "light" } = Astro.props;
---

<header class:list={["hall-head", tone]} data-reveal>
  <svg class="pediment" viewBox="0 0 400 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M6 64L200 6l194 58z" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M30 60L200 15l170 45" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
  </svg>
  <span class="numeral">{numeral}</span>
  <span class="greek" lang="el">{greek}</span>
  <h2>{title}</h2>
  {intro && <p class="intro">{intro}</p>}
  <div class="meander rule" aria-hidden="true"></div>
</header>

<style>
  .hall-head {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(40px, 6vw, 64px);
    color: var(--gold);
  }
  .pediment {
    width: min(360px, 80%);
    height: 54px;
    margin-bottom: 4px;
  }
  .greek {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.5em;
    color: var(--ink-3);
    margin-top: 2px;
  }
  h2 {
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    margin-top: 8px;
  }
  .intro {
    margin: 14px 0 0;
    font-size: 1.15rem;
    font-style: italic;
    color: var(--ink-2);
  }
  .rule {
    width: 200px;
    margin-top: 22px;
  }
  .dark h2 {
    color: var(--marble);
  }
  .dark .greek,
  .dark .intro {
    color: #c9d3dc;
  }
</style>
