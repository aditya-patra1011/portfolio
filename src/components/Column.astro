---
// A Doric column drawn in SVG: abacus, echinus, fluted shaft with entasis, base.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const flutes = Array.from({ length: 7 }, (_, i) => 16 + i * 8);
---

<svg class:list={["column", className]} viewBox="0 0 80 400" preserveAspectRatio="none" aria-hidden="true">
  <defs>
    <linearGradient id="col-shade" x1="0" x2="1">
      <stop offset="0" stop-color="#cfc4ad" />
      <stop offset="0.35" stop-color="#fbf7ee" />
      <stop offset="0.7" stop-color="#e9e0cd" />
      <stop offset="1" stop-color="#b9ad94" />
    </linearGradient>
  </defs>
  <rect x="2" y="0" width="76" height="12" fill="url(#col-shade)" stroke="#a89a7c" stroke-width="0.8" />
  <path d="M8 12h64l-6 14H14z" fill="url(#col-shade)" stroke="#a89a7c" stroke-width="0.8" />
  <path d="M14 26h52l-3 344H17z" fill="url(#col-shade)" stroke="#a89a7c" stroke-width="0.8" />
  {flutes.map((x) => <path d={`M${x} 30L${x + (x < 40 ? 1 : x > 40 ? -1 : 0)} 366`} stroke="#b3a68b" stroke-width="1" opacity="0.6" />)}
  <rect x="10" y="370" width="60" height="12" fill="url(#col-shade)" stroke="#a89a7c" stroke-width="0.8" />
  <rect x="4" y="382" width="72" height="18" fill="url(#col-shade)" stroke="#a89a7c" stroke-width="0.8" />
</svg>

<style>
  .column {
    display: block;
    filter: drop-shadow(0 10px 18px rgba(40, 30, 10, 0.25));
  }
</style>
