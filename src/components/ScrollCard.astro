---
// A project shown as a rolled-up papyrus scroll. It links to the project page; with JS it opens
// the unrolling scroll view instead.
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, status, year, domains, cover } = project.data;
const roman = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"][index] ?? String(index + 1);
---

<a class="scroll-card" href={`/projects/${project.id}/`} data-scroll-open={project.id} data-reveal>
  <span class="rod" aria-hidden="true"></span>
  <div class="paper">
    <span class="no">Scroll {roman}</span>
    {cover && <img src={cover} alt="" loading="lazy" />}
    <h3>{title}</h3>
    <p class="meta">
      <span class="status" data-status={status}>{status === "shipped" ? "Complete" : "In progress"}</span>
      {` · ${year} · ${domains[0]}`}
    </p>
    <p class="summary">{summary}</p>
    <span class="unroll">Unroll the scroll ›</span>
  </div>
  <span class="rod bottom" aria-hidden="true"></span>
</a>

<style>
  .scroll-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s ease;
  }
  .scroll-card:hover {
    transform: translateY(-6px) rotate(-0.6deg);
    color: inherit;
  }
  /* wooden rods with knobs */
  .rod {
    position: relative;
    z-index: 1;
    height: 18px;
    margin-inline: -6px;
    border-radius: 9px;
    background: linear-gradient(180deg, #a8743a, #6e4317 55%, #4a2c0e);
    box-shadow: 0 4px 8px rgba(40, 25, 5, 0.35);
  }
  .rod::before,
  .rod::after {
    content: "";
    position: absolute;
    top: -4px;
    width: 14px;
    height: 26px;
    border-radius: 6px;
    background: linear-gradient(180deg, #e2bd62, #9a6f22);
  }
  .rod::before {
    left: -10px;
  }
  .rod::after {
    right: -10px;
  }
  .paper {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-block: -6px;
    padding: 26px 22px 22px;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(120, 80, 20, 0.18), transparent 22%),
      radial-gradient(ellipse at 50% 100%, rgba(120, 80, 20, 0.18), transparent 22%),
      linear-gradient(90deg, rgba(150, 105, 40, 0.18), transparent 8%, transparent 92%, rgba(150, 105, 40, 0.18)),
      var(--parchment);
    box-shadow: 0 14px 30px rgba(60, 40, 10, 0.18);
  }
  .no {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--terracotta);
    text-align: center;
  }
  img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border: 4px solid #fff6df;
    box-shadow: 0 4px 10px rgba(60, 40, 10, 0.2);
    filter: sepia(0.35) saturate(0.9);
    transition: filter 0.4s;
  }
  .scroll-card:hover img {
    filter: none;
  }
  h3 {
    font-size: 1.25rem;
    color: #3a2a16;
    text-align: center;
    margin-top: 4px;
  }
  .meta {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    color: #7b6646;
  }
  .summary {
    margin: 0;
    font-size: 1rem;
    color: #4a3b26;
  }
  .unroll {
    margin-top: auto;
    padding-top: 6px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aegean);
  }
  .scroll-card:hover .unroll {
    color: var(--terracotta);
  }
</style>
