---
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  size?: "large" | "default";
}

const { project, size = "default" } = Astro.props;
const { title, summary, status, domains, stack, highlights, year, cover } = project.data;
const href = `/projects/${project.id}/`;
---

<article class:list={["card panel", size]}>
  <div class="bar">
    <span class="path">~/projects/<b>{project.id}</b></span>
    <span class="status" data-status={status}>{status === "shipped" ? "SHIPPED" : "RUNNING"}</span>
  </div>
  {
    cover && (
      <div class="cover">
        <img src={cover} alt="" loading="lazy" />
      </div>
    )
  }
  <div class="body">
    <p class="meta mono">{year} · {domains.join(" / ").toLowerCase()}</p>
    <h3><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
    {
      size === "large" && highlights.length > 0 && (
        <ul class="highlights">
          {highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    <div class="stack">
      {stack.slice(0, size === "large" ? 8 : 5).map((s) => <span class="tag">{s}</span>)}
    </div>
    <span class="open mono" aria-hidden="true">open →</span>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--neon-dim);
    box-shadow:
      0 0 0 1px rgba(var(--neon-rgb), 0.15),
      0 0 40px rgba(var(--neon-rgb), 0.08);
  }
  .card:hover::before,
  .card:hover::after {
    border-color: var(--neon);
    width: 18px;
    height: 18px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-3px);
    }
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 9px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--ink-3);
    background: rgba(var(--neon-rgb), 0.02);
  }
  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .path b {
    color: var(--ink-2);
    font-weight: 500;
  }
  .cover {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .cover img {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    object-position: top;
    filter: saturate(0.6) brightness(0.8);
    transition: filter 0.3s;
  }
  .cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.25) 3px),
      linear-gradient(180deg, transparent 50%, rgba(3, 6, 4, 0.9));
    mix-blend-mode: multiply;
  }
  .card:hover .cover img {
    filter: saturate(1) brightness(1);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    flex: 1;
  }
  .large .body {
    padding: clamp(20px, 3vw, 30px);
  }
  .meta {
    margin: 0;
    color: var(--neon-dim);
  }
  h3 {
    font-size: 1.3rem;
  }
  .large h3 {
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
  }
  /* Whole card is clickable via the title link. */
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-shadow: none;
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card:hover h3 {
    color: var(--neon);
  }
  .summary {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .highlights {
    margin: 0;
    padding: 12px 14px;
    list-style: none;
    display: grid;
    gap: 4px;
    font-size: 0.8rem;
    color: var(--ink);
    border-left: 2px solid var(--neon);
    background: rgba(var(--neon-rgb), 0.04);
  }
  .highlights li::before {
    content: "▸ ";
    color: var(--neon);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 4px;
  }
  .open {
    align-self: flex-end;
    color: var(--ink-3);
    transition: color 0.2s;
  }
  .card:hover .open {
    color: var(--neon);
  }
</style>
