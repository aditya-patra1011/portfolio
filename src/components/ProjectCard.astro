---
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, status, domains, stack, year, cover } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="card" data-reveal>
  <div class="frame">
    {
      cover ? (
        <img src={cover} alt="" loading="lazy" />
      ) : (
        <div class="placeholder" aria-hidden="true">
          {title.slice(0, 2)}
        </div>
      )
    }
    <div class="overlay" aria-hidden="true">
      <span class="plus">+</span>
      <span class="label">View case study</span>
    </div>
  </div>
  <div class="body">
    <div class="meta">
      <span>{year} · {domains.join(" / ")}</span>
      <span class="status" data-status={status}>{status === "shipped" ? "Shipped" : "In progress"}</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
    <div class="stack">
      {stack.slice(0, 4).map((s) => <span class="tag">{s}</span>)}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    padding: 18px;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
  }
  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #0b0e0f;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s ease;
  }
  .card:hover .frame img {
    transform: scale(1.06);
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: 4rem;
    color: rgba(var(--green-rgb), 0.35);
    text-transform: uppercase;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(var(--green-rgb), 0.88);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .card:hover .overlay {
    opacity: 1;
  }
  .plus {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #fff;
    color: var(--green);
    font-size: 1.8rem;
    line-height: 1;
    transform: scale(0.6);
    transition: transform 0.3s;
  }
  .card:hover .plus {
    transform: scale(1);
  }
  .label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 4px 4px;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 12px;
    font-size: 0.78rem;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  h3 {
    font-size: 1.35rem;
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card:hover h3 {
    color: var(--green);
  }
  p {
    margin: 0;
    font-size: 0.93rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
</style>
