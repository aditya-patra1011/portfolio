---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <p class="mono">
      <span class="ok">[ok]</span> © {year} {site.name} · {site.location} · built with Astro
    </p>
    <ul>
      <li><a href={site.links.github}>github</a></li>
      <li><a href={site.links.linkedin}>linkedin</a></li>
      <li><a href={`mailto:${site.links.email}`}>email</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: rgba(3, 6, 4, 0.7);
    padding-block: 24px;
    color: var(--ink-3);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
  }
  p {
    margin: 0;
  }
  .ok {
    color: var(--neon);
  }
  ul {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.82rem;
  }
  a {
    color: var(--ink-2);
    text-decoration: none;
  }
</style>
