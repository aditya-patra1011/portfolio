---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="meander" aria-hidden="true"></div>
  <div class="wrap inner">
    <p class="motto">
      <span lang="el">ΓΝΩΘΙ ΣΕΑΥΤΟΝ</span>
      <span class="tr">Know thyself, and validate your models</span>
    </p>
    <ul>
      <li><a href={site.links.github}>GitHub</a></li>
      <li><a href={site.links.linkedin}>LinkedIn</a></li>
      <li><a href={`mailto:${site.links.email}`}>Email</a></li>
      <li><a href={site.links.resume}>Résumé</a></li>
    </ul>
    <p class="copy">© {year} {site.name} · {site.location}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--aegean-deep);
    color: #c3ccd5;
    text-align: center;
  }
  .footer .meander {
    filter: brightness(1.2);
  }
  .inner {
    padding-block: 40px;
  }
  .motto {
    display: grid;
    gap: 2px;
    margin: 0 0 18px;
  }
  .motto span:first-child {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.3em;
    color: var(--gold-light);
  }
  .tr {
    font-style: italic;
    font-size: 0.95rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  a {
    text-decoration: none;
    color: #fff;
  }
  a:hover {
    color: var(--gold-light);
  }
  .copy {
    margin: 0;
    font-size: 0.9rem;
    color: #8a98a6;
  }
</style>
