---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { getProjects, byTier } from "../lib/projects";
import { site, skills } from "../data/site";

const projects = await getProjects();
const flagship = byTier(projects, "flagship");
const featured = byTier(projects, "featured");
const more = byTier(projects, "more");

const shipped = projects.filter((p) => p.data.status === "shipped").length;
const ticker = projects.flatMap((p) => p.data.highlights.map((h) => ({ id: p.id, text: h })));
---

<BaseLayout>
  <section class="hero wrap">
    <div class="intro">
      <p class="boot mono">
        <span class="neon">[ OK ]</span> session started · {site.location.toLowerCase()} · {projects.length} projects loaded
      </p>
      <h1 class="name">
        <span class="glitch" data-text="ADITYA">ADITYA</span><br />
        <span class="glitch neon-text" data-text="PATRA">PATRA</span>
      </h1>
      <p class="role">&gt; {site.role.toLowerCase()}<span class="caret" aria-hidden="true"></span></p>
      <p class="tagline">{site.tagline}</p>
      <div class="cta">
        <a class="btn primary" href="/projects/">view_projects</a>
        <a class="btn" href={site.links.github}>github</a>
      </div>
    </div>

    <div class="term panel" data-term>
      <div class="term-bar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mono">aditya@portfolio: ~</span>
        <span class="mono live">● live</span>
      </div>
      <div class="term-body">
        <p class="cmd"><span class="ps">$</span> <span data-type>whoami</span></p>
        <p class="out">{site.name} <span class="dim">// {site.education.degree.split(",")[0]}, {site.education.note}</span></p>
        <p class="cmd"><span class="ps">$</span> <span data-type>cat mission.txt</span></p>
        <p class="out">Turning public data into ML systems you can actually inspect.</p>
        <p class="cmd"><span class="ps">$</span> <span data-type>ls ~/projects --flagship</span></p>
        <p class="out">{flagship.map((p) => <a class="dir" href={`/projects/${p.id}/`}>{p.id}/</a>)}</p>
        <p class="cmd"><span class="ps">$</span> <span data-type>./status --now</span></p>
        <p class="out">
          <span class="warn">[RUNNING]</span>
          <a href={`/projects/${site.now.project}/`}>{site.now.text}</a>
        </p>
        <p class="out stats">
          <span><b>{projects.length}</b> projects</span>
          <span><b>{shipped}</b> shipped</span>
          <span><b>{projects.length - shipped}</b> in progress</span>
        </p>
        <p class="cmd last"><span class="ps">$</span> <span class="caret" aria-hidden="true"></span></p>
      </div>
    </div>
  </section>

  {
    ticker.length > 0 && (
      <div class="ticker" aria-label="Project highlights">
        <div class="track">
          {[0, 1].map((copy) => (
            <ul aria-hidden={copy === 1 ? "true" : undefined}>
              {ticker.map((t) => (
                <li>
                  <span class="neon">[{t.id}]</span> {t.text}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    )
  }

  <section class="section wrap" id="work">
    <div class="section-head">
      <h2><span class="idx">01</span>flagship_work</h2>
      <a href="/projects/">ls -a →</a>
    </div>
    <div class="flagship">
      {flagship.map((p) => <ProjectCard project={p} size="large" />)}
    </div>
  </section>

  <section class="wrap">
    <div class="section-head">
      <h2><span class="idx">02</span>featured</h2>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2>
            <span class="idx">03</span>more_projects
          </h2>
        </div>
        <ul class="list panel">
          {more.map((p) => (
            <ProjectRow project={p} />
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap">
    <div class="section-head">
      <h2><span class="idx">04</span>toolkit</h2>
      <a href="/about/">cat about.md →</a>
    </div>
    <div class="config panel">
      <p class="mono file"># ~/.config/stack.yml</p>
      <dl>
        {
          skills.map((s) => (
            <div class="kv">
              <dt>{s.group.toLowerCase().replace(/[^a-z]+/g, "_")}:</dt>
              <dd>
                [{s.items.map((it, i) => (
                  <>
                    <span class="val">{it}</span>
                    {i < s.items.length - 1 && ", "}
                  </>
                ))}]
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section wrap">
    <div class="contact panel">
      <p class="eyebrow">open to work</p>
      <h2>Looking for an ML / data internship or graduate role.</h2>
      <p class="sub">The fastest way to reach me is email. I usually reply within a day.</p>
      <a class="btn primary" href={`mailto:${site.links.email}`}>{site.links.email}</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Type out each command in the hero terminal, revealing outputs between them.
  const term = document.querySelector<HTMLElement>("[data-term]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (term && !reduce) {
    const lines = [...term.querySelectorAll<HTMLElement>(".term-body > p")];
    const typed = new Map<HTMLElement, string>();
    lines.forEach((l) => {
      const target = l.querySelector<HTMLElement>("[data-type]");
      if (target) {
        typed.set(target, target.textContent ?? "");
        target.textContent = "";
      }
      l.style.visibility = "hidden";
    });
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      await wait(350);
      for (const l of lines) {
        l.style.visibility = "visible";
        const target = l.querySelector<HTMLElement>("[data-type]");
        if (target) {
          const text = typed.get(target)!;
          for (let i = 1; i <= text.length; i++) {
            target.textContent = text.slice(0, i);
            await wait(18 + Math.random() * 30);
          }
          await wait(180);
        } else {
          await wait(90);
        }
      }
    })();
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(56px, 10vw, 120px) clamp(40px, 6vw, 72px);
  }
  .boot {
    color: var(--ink-3);
    margin: 0 0 20px;
  }
  .name {
    font-size: clamp(3.2rem, 9vw, 6.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }
  .neon-text {
    color: var(--neon);
    text-shadow:
      0 0 10px rgba(var(--neon-rgb), 0.6),
      0 0 40px rgba(var(--neon-rgb), 0.3);
  }
  .glitch {
    position: relative;
    display: inline-block;
  }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .glitch::before {
    color: var(--cyan);
    text-shadow: none;
  }
  .glitch::after {
    color: #ff3d7f;
    text-shadow: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .glitch::before {
      animation: glitch-a 7s infinite steps(1);
    }
    .glitch::after {
      animation: glitch-b 7s infinite steps(1);
    }
    @keyframes glitch-a {
      0%, 91%, 100% { opacity: 0; transform: none; clip-path: none; }
      92% { opacity: 0.8; transform: translate(-3px, 1px); clip-path: inset(10% 0 55% 0); }
      94% { opacity: 0.8; transform: translate(3px, -1px); clip-path: inset(60% 0 8% 0); }
      96% { opacity: 0.6; transform: translate(-2px, 0); clip-path: inset(35% 0 40% 0); }
    }
    @keyframes glitch-b {
      0%, 91%, 100% { opacity: 0; transform: none; clip-path: none; }
      93% { opacity: 0.7; transform: translate(3px, 0); clip-path: inset(50% 0 20% 0); }
      95% { opacity: 0.7; transform: translate(-3px, 1px); clip-path: inset(5% 0 70% 0); }
    }
  }
  .role {
    margin: 22px 0 0;
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--neon);
  }
  .tagline {
    max-width: 52ch;
    color: var(--ink-2);
    margin: 14px 0 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  /* terminal */
  .term {
    font-size: 0.86rem;
    box-shadow:
      0 0 0 1px rgba(var(--neon-rgb), 0.05),
      0 30px 80px rgba(0, 0, 0, 0.6),
      0 0 60px rgba(var(--neon-rgb), 0.06);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
  }
  .lights i:first-child {
    background: var(--neon);
    border-color: var(--neon);
    box-shadow: 0 0 8px var(--neon);
  }
  .live {
    margin-left: auto;
    color: var(--neon);
  }
  .term-body {
    padding: 18px 18px 20px;
    min-height: 340px;
  }
  .term-body p {
    margin: 0;
  }
  .cmd {
    color: var(--ink);
    margin-top: 10px !important;
  }
  .cmd:first-child {
    margin-top: 0 !important;
  }
  .ps {
    color: var(--neon);
    text-shadow: var(--glow);
  }
  .out {
    color: var(--ink-2);
  }
  .out a {
    text-decoration: none;
  }
  .dim {
    color: var(--ink-3);
  }
  .dir {
    color: var(--cyan);
    margin-right: 14px;
  }
  .warn {
    color: var(--amber);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 6px !important;
    color: var(--ink-3);
  }
  .stats b {
    color: var(--neon);
    font-weight: 600;
  }

  /* highlights ticker */
  .ticker {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: rgba(3, 8, 5, 0.75);
    font-size: 0.8rem;
    color: var(--ink-2);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
  }
  .ticker ul {
    display: flex;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 12px 24px;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: marquee 60s linear infinite;
    }
    .ticker:hover .track {
      animation-play-state: paused;
    }
    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }
  }

  .flagship {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 4px 20px;
  }

  .config {
    padding: 22px 24px;
  }
  .file {
    color: var(--ink-3);
    margin: 0 0 14px;
  }
  .config dl {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .kv {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 12px;
  }
  dt {
    color: var(--cyan);
  }
  dd {
    margin: 0;
    color: var(--ink-3);
  }
  .val {
    color: var(--ink);
  }

  .contact {
    padding: clamp(28px, 5vw, 56px);
    text-align: left;
    background:
      linear-gradient(135deg, rgba(var(--neon-rgb), 0.08), transparent 55%),
      var(--panel);
  }
  .contact h2 {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    max-width: 22ch;
    margin-top: 10px;
  }
  .contact .sub {
    color: var(--ink-2);
    margin: 14px 0 26px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .term-body {
      min-height: 0;
    }
  }
  @media (max-width: 560px) {
    .kv {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
