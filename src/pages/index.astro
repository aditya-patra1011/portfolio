---
import BaseLayout from "../layouts/BaseLayout.astro";
import Column from "../components/Column.astro";
import HallHead from "../components/HallHead.astro";
import ScrollCard from "../components/ScrollCard.astro";
import Poseidon from "../components/Poseidon.astro";
import { getProjects } from "../lib/projects";
import { site, experience, stats, services, skills } from "../data/site";

const projects = await getProjects();
const flagships = projects.filter((p) => p.data.tier === "flagship");
const featured = projects.filter((p) => p.data.tier === "featured");
const numerals = ["I", "II", "III", "IV"];
---

<BaseLayout>
  <!-- ENTRANCE: the temple front above the sea -->
  <section
    class="entrance"
    id="entrance"
    data-tour-title="The Entrance"
    data-tour="Chaire, traveller! I'm Poseidon, keeper of this temple. Aditya builds machine-learning systems. Press Next, or scroll, and I'll show you around."
  >
    <div class="sky" aria-hidden="true">
      <span class="sun"></span>
      <span class="gull g1"></span><span class="gull g2"></span>
    </div>

    <div class="temple">
      <svg class="pediment" viewBox="0 0 1000 150" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="ped" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="#fbf7ee" />
            <stop offset="1" stop-color="#e3d9c5" />
          </linearGradient>
        </defs>
        <path d="M0 150L500 8l500 142z" fill="url(#ped)" stroke="#b5a688" stroke-width="2" />
        <path d="M60 140L500 26l440 114z" fill="none" stroke="#c8bb9f" stroke-width="2" />
        <!-- small trident in the tympanum -->
        <g stroke="#b8892f" stroke-width="5" stroke-linecap="round" fill="none">
          <path d="M500 128V62M478 62v18a22 22 0 0 0 44 0V62" />
        </g>
        <path d="M472 64l6-14 6 14zM494 62l6-16 6 16zM516 64l6-14 6 14z" fill="#b8892f" />
      </svg>
      <div class="architrave">
        <span>M · ADITYA · PATRA</span>
      </div>
      <div class="meander frieze" aria-hidden="true"></div>

      <div class="colonnade">
        <Column class="col outer" /><Column class="col" />
        <div class="cella" data-reveal>
          <span class="greet" lang="el">ΧΑΙΡΕ · Welcome, traveller</span>
          <h1>{site.name}</h1>
          <p class="role">Machine-learning engineer in the making · {site.location}</p>
          <p class="tagline">{site.tagline}</p>
          <div class="actions">
            <a class="btn" href="#oracle">Enter the temple</a>
            <a class="btn gold" href="#treasury">See the treasury</a>
          </div>
        </div>
        <Column class="col" /><Column class="col outer" />
      </div>
      <div class="steps" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>

    <svg class="sea" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="w1" d="M0 50c120-30 240 30 360 0s240-30 360 0 240 30 360 0 240-30 360 0v70H0z" />
      <path class="w2" d="M0 70c120-26 240 26 360 0s240-26 360 0 240 26 360 0 240-26 360 0v50H0z" />
      <path class="w3" d="M0 92c120-18 240 18 360 0s240-18 360 0 240 18 360 0 240-18 360 0v28H0z" />
    </svg>
  </section>

  <!-- HALL I: THE ORACLE (about) -->
  <section
    class="hall"
    id="oracle"
    data-tour-title="The Oracle"
    data-tour="This is the Oracle, where you learn who he is: a Computer Science student in Pune who likes real, messy data and honest models."
  >
    <div class="wrap">
      <HallHead numeral="Hall I" greek="ΜΑΝΤΕΙΟΝ" title="The Oracle" intro="Who is the builder of this temple?" />
      <div class="oracle">
        <div class="stele" data-reveal>
          <span class="stele-top" aria-hidden="true"></span>
          <dl>
            <div><dt>Name</dt><dd>{site.name}</dd></div>
            <div><dt>Dwells in</dt><dd>{site.location}</dd></div>
            <div><dt>Studies</dt><dd>{site.education.degree}, {site.education.school}</dd></div>
            <div><dt>Seeks</dt><dd>ML / data internships and graduate roles</dd></div>
          </dl>
        </div>
        <div class="words" data-reveal>
          <p class="drop">
            I'm a {site.education.note} Computer Science student at {site.education.school}. I like projects where
            the data is real and messy and the question is concrete: which tyre should this driver pit for, which
            Kepler signals are actually planets, which two satellites are about to get too close.
          </p>
          <p>
            I care about the parts of machine learning that are easy to skip: validation splits that don't leak,
            checking where a model's accuracy really comes from, and packaging the result so someone else can run it.
          </p>
          <a class="btn" href={site.links.resume}>Read the résumé</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HALL II: THE LABOURS (career, numbers, skills) -->
  <section
    class="hall alt"
    id="labours"
    data-tour-title="The Labours"
    data-tour="His labours so far: an ML internship, his degree, and the numbers his projects produced. Over 14,000 objects in orbit, by my beard!"
  >
    <div class="wrap">
      <HallHead numeral="Hall II" greek="ΑΘΛΟΙ" title="The Labours" intro="Study, an internship, and what the work has produced." />
      <div class="tablets">
        {
          experience.map((e, i) => (
            <article class="tablet" data-reveal>
              <span class="tab-no">{numerals[i]}</span>
              <span class="period">{e.period}</span>
              <h3>{e.org}</h3>
              <p class="role">{e.role}</p>
              {e.clubs ? (
                <ul class="clubs">
                  {e.clubs.map((c) => (
                    <li>
                      <strong>{c.name}</strong>
                      <span class="club-meta">
                        {c.role} · since {c.since}
                      </span>
                      <span class="club-text">{c.text}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>{e.text}</p>
              )}
            </article>
          ))
        }
      </div>

      <div class="coins">
        {
          stats.map((s) => (
            <div class="coin" data-reveal>
              <div class="face">
                <span class="value">{s.value}</span>
              </div>
              <h3>{s.label}</h3>
              <span class="note">{s.note}</span>
            </div>
          ))
        }
      </div>

      <div class="frieze-skills" data-reveal>
        {
          skills.map((s) => (
            <div>
              <h4>{s.group}</h4>
              <p>{s.items.join(" · ")}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HALL III: THE GIFTS (services) -->
  <section
    class="hall"
    id="gifts"
    data-tour-title="The Gifts"
    data-tour="These are the gifts he brings to a team: machine-learning engineering, careful statistics, and dashboards people can explore."
  >
    <div class="wrap">
      <HallHead numeral="Hall III" greek="ΔΩΡΑ" title="The Gifts" intro="What I bring to a team." />
      <div class="gifts">
        {
          services.map((s) => (
            <article class="gift" data-reveal>
              <span class="capital" aria-hidden="true" />
              <div class="shaft">
                <div class="icon" aria-hidden="true">
                  {s.icon === "ml" && (
                    <svg viewBox="0 0 64 64">
                      <circle cx="16" cy="16" r="6" /><circle cx="16" cy="48" r="6" /><circle cx="48" cy="32" r="8" />
                      <path d="M22 18l18 11M22 46l18-11M16 22v20" />
                    </svg>
                  )}
                  {s.icon === "stats" && (
                    <svg viewBox="0 0 64 64">
                      <path d="M24 6h16M26 6v8c-10 4-14 14-12 26 2 10 8 16 18 16s16-6 18-16c2-12-2-22-12-26V6" />
                      <path d="M22 44v-6M30 44V30M38 44v-9M46 44V26" />
                    </svg>
                  )}
                  {s.icon === "dash" && (
                    <svg viewBox="0 0 64 64">
                      <rect x="6" y="10" width="52" height="38" rx="2" /><path d="M24 56h16M32 48v8" /><path d="M14 38l9-10 7 6 12-14 8 6" />
                    </svg>
                  )}
                </div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
              <span class="base" aria-hidden="true" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HALL IV: THE TREASURY (projects as scrolls) -->
  <section
    class="hall treasury"
    id="treasury"
    data-tour-title="The Treasury"
    data-tour="The treasury! Every project here is a scroll. Click one to unroll it. His three flagships come first, and OrbitGuard's dashboard is live."
    data-tour-point="#treasury .scroll-card"
  >
    <div class="wrap">
      <HallHead
        numeral="Hall IV"
        greek="ΘΗΣΑΥΡΟΣ"
        title="The Treasury"
        intro="Every project is kept on a scroll. Click one to unroll it."
      />
      <div class="flagships">
        {flagships.map((p, i) => <ScrollCard project={p} index={i} variant="flagship" />)}
      </div>
      <h3 class="sub" data-reveal>More scrolls</h3>
      <div class="scrolls">
        {featured.map((p, i) => <ScrollCard project={p} index={flagships.length + i} />)}
      </div>
      <div class="more" data-reveal>
        <a class="btn gold" href="/projects/">Enter the full treasury · {projects.length} scrolls</a>
      </div>
    </div>
  </section>

  <!-- HALL V: THE ALTAR (contact) -->
  <section
    class="altar-hall"
    id="altar"
    data-tour-title="The Altar"
    data-tour="And here is the altar. Leave an offering: send Aditya an email. He replies within a day."
    data-tour-point="#offering"
  >
    <div class="stars" aria-hidden="true"></div>
    <div class="wrap">
      <HallHead numeral="Hall V" greek="ΒΩΜΟΣ" title="The Altar" intro="Leave an offering. A message works best." tone="dark" />
      <div class="altar-grid">
        <div class="altar" aria-hidden="true">
          <div class="flame"><i></i><i></i><i></i></div>
          <svg viewBox="0 0 200 150">
            <path d="M30 20h140v14H30z" fill="#e9e0cd" stroke="#a89a7c" />
            <path d="M44 34h112v96H44z" fill="#f4efe4" stroke="#a89a7c" />
            <path d="M44 52h112M44 112h112" stroke="#b8892f" stroke-width="3" />
            <path d="M24 130h152v16H24z" fill="#e9e0cd" stroke="#a89a7c" />
            <circle cx="100" cy="82" r="16" fill="none" stroke="#b8892f" stroke-width="3" />
            <path d="M100 70v24M92 74v6a8 8 0 0 0 16 0v-6" stroke="#b8892f" stroke-width="2.5" fill="none" />
          </svg>
        </div>
        <div class="offering" data-reveal>
          <p>
            I'm looking for an <strong>ML / data internship or graduate role</strong>. If you have one, or just want
            to talk about a project, write to me.
          </p>
          <a id="offering" class="btn gold big" href={`mailto:${site.links.email}`}>{site.links.email}</a>
          <div class="also">
            <a href={site.links.linkedin}>LinkedIn</a>
            <a href={site.links.github}>GitHub</a>
            <a href={site.links.resume}>Résumé</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Poseidon slot="after" />
</BaseLayout>

<style>
  /* ---------- entrance ---------- */
  .entrance {
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 6vw, 70px) 0 0;
    background: linear-gradient(180deg, #0f2f4d 0%, #2a5f86 38%, #e8a95b 78%, #f6d28c 100%);
  }
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sun {
    position: absolute;
    left: 50%;
    bottom: 120px;
    width: 220px;
    height: 220px;
    margin-left: -110px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff3c8 0%, #f8c76c 45%, rgba(248, 199, 108, 0) 70%);
  }
  .gull {
    position: absolute;
    width: 26px;
    height: 10px;
    border-top: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 50% 50% 0 0;
  }
  .gull::after {
    content: "";
    position: absolute;
    left: 12px;
    top: -2px;
    width: 26px;
    height: 10px;
    border-top: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 50% 50% 0 0;
  }
  .g1 {
    top: 18%;
    left: 12%;
  }
  .g2 {
    top: 26%;
    right: 14%;
    transform: scale(0.7);
  }
  @media (prefers-reduced-motion: no-preference) {
    .gull {
      animation: glide 9s ease-in-out infinite;
    }
    .g2 {
      animation-delay: -4s;
    }
    @keyframes glide {
      50% {
        translate: 30px -12px;
      }
    }
  }

  .temple {
    position: relative;
    z-index: 1;
    width: min(1020px, 94vw);
    margin: 0 auto;
  }
  .pediment {
    display: block;
    width: 100%;
    height: clamp(70px, 11vw, 140px);
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.25));
  }
  .architrave {
    display: grid;
    place-items: center;
    height: 46px;
    background: linear-gradient(180deg, #f8f3e8, #e4dac6);
    border-block: 2px solid #b5a688;
  }
  .architrave span {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 2vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.4em;
    color: #8c7a55;
  }
  .frieze {
    background-color: var(--aegean);
  }
  .colonnade {
    display: grid;
    grid-template-columns: 70px 70px 1fr 70px 70px;
    gap: clamp(8px, 2vw, 22px);
    align-items: stretch;
    padding-inline: 8px;
  }
  .colonnade :global(.col) {
    width: 100%;
    height: 100%;
    min-height: 420px;
  }
  .cella {
    align-self: center;
    margin-block: 30px;
    padding: clamp(24px, 4vw, 44px);
    text-align: center;
    background: rgba(250, 246, 236, 0.94);
    border: 1px solid #d3c7ae;
    box-shadow:
      inset 0 0 0 6px rgba(250, 246, 236, 0.94),
      inset 0 0 0 7px rgba(184, 137, 47, 0.6),
      0 20px 40px rgba(0, 0, 0, 0.25);
  }
  .greet {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    color: var(--terracotta);
  }
  h1 {
    font-size: clamp(2.2rem, 5.4vw, 3.8rem);
    margin: 10px 0 6px;
  }
  .role {
    margin: 0;
    font-style: italic;
    font-size: 1.15rem;
    color: var(--sea);
  }
  .tagline {
    max-width: 52ch;
    margin: 16px auto 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 26px;
  }
  .steps {
    display: grid;
  }
  .steps i {
    display: block;
    height: 14px;
    background: linear-gradient(180deg, #f6f1e6, #d6cbb4);
    border-bottom: 1px solid #b5a688;
  }
  .steps i:nth-child(2) {
    margin-inline: -14px;
  }
  .steps i:nth-child(3) {
    margin-inline: -28px;
  }
  .sea {
    position: relative;
    display: block;
    width: 100%;
    height: 90px;
    margin-top: -6px;
  }
  .sea path {
    transform-box: fill-box;
  }
  .w1 {
    fill: #2f7f9d;
  }
  .w2 {
    fill: #1f6f8b;
  }
  .w3 {
    fill: #123a5c;
  }
  @media (prefers-reduced-motion: no-preference) {
    .w1 {
      animation: swell 7s ease-in-out infinite;
    }
    .w2 {
      animation: swell 5.5s ease-in-out infinite reverse;
    }
    @keyframes swell {
      50% {
        transform: translateX(-60px);
      }
    }
  }

  /* ---------- halls ---------- */
  .hall {
    position: relative;
    padding-block: clamp(72px, 10vw, 120px);
  }
  .hall.alt {
    background: rgba(217, 207, 187, 0.35);
    border-block: 1px solid var(--line);
  }

  /* oracle */
  .oracle {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .stele {
    position: relative;
    padding: 70px 34px 34px;
    background: linear-gradient(180deg, #f7f2e8, #e3d8c3);
    border: 1px solid #c3b597;
    border-radius: 140px 140px 6px 6px;
    box-shadow: 0 20px 40px rgba(60, 45, 20, 0.18);
    text-align: center;
  }
  .stele-top {
    position: absolute;
    top: 22px;
    left: 50%;
    width: 44px;
    height: 34px;
    margin-left: -22px;
    background: var(--meander) center / 40px 20px;
    border-radius: 4px;
  }
  .stele dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .stele dt {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .stele dd {
    margin: 2px 0 0;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .words p {
    margin: 0 0 18px;
    font-size: 1.15rem;
  }
  .drop::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 3.8rem;
    line-height: 0.9;
    padding: 6px 10px 0 0;
    color: var(--terracotta);
  }

  /* labours */
  .tablets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .tablet {
    position: relative;
    padding: 30px 22px 24px;
    background: linear-gradient(180deg, #f8f4ea, #e8dfcc);
    border: 1px solid #c9bc9f;
    box-shadow: 0 14px 28px rgba(60, 45, 20, 0.14);
    text-align: center;
  }
  .tab-no {
    position: absolute;
    top: -16px;
    left: 50%;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-left: -17px;
    border-radius: 50%;
    background: var(--aegean);
    color: var(--gold-light);
    font-family: var(--font-display);
    font-size: 0.85rem;
  }
  .period {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--terracotta);
  }
  .tablet h3 {
    font-size: 1.12rem;
    margin: 8px 0 2px;
  }
  .tablet .role {
    margin: 0 0 8px;
    font-style: italic;
    color: var(--sea);
  }
  .tablet p:last-child {
    margin: 0;
    font-size: 1rem;
  }
  .clubs {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .clubs li {
    display: grid;
    gap: 1px;
    font-size: 0.98rem;
  }
  .clubs li + li {
    padding-top: 12px;
    border-top: 1px solid rgba(184, 137, 47, 0.35);
  }
  .clubs strong {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .club-meta {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--terracotta);
  }
  .coins {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    margin-top: clamp(56px, 8vw, 84px);
    text-align: center;
  }
  .coin {
    display: grid;
    justify-items: center;
  }
  .face {
    display: grid;
    place-items: center;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f6db8f, #c99a3b 60%, #8f6721);
    box-shadow:
      inset 0 0 0 6px rgba(255, 240, 200, 0.35),
      inset 0 0 0 10px rgba(110, 75, 20, 0.35),
      0 12px 24px rgba(90, 60, 10, 0.3);
  }
  .value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: #4a3410;
    text-shadow: 0 1px 0 rgba(255, 240, 200, 0.6);
  }
  .coin h3 {
    font-size: 1rem;
    margin-top: 16px;
  }
  .note {
    font-style: italic;
    color: var(--sea);
  }
  .frieze-skills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(56px, 8vw, 80px);
    background: var(--aegean);
    color: #d7e1ea;
    border-block: 4px solid var(--gold);
  }
  .frieze-skills > div {
    padding: 24px 22px;
    border-right: 1px solid rgba(226, 189, 98, 0.35);
  }
  .frieze-skills > div:last-child {
    border-right: 0;
  }
  .frieze-skills h4 {
    font-size: 0.9rem;
    color: var(--gold-light);
    margin-bottom: 6px;
  }
  .frieze-skills p {
    margin: 0;
    font-size: 1rem;
  }

  /* gifts: each card is a column */
  .gifts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 4vw, 48px);
  }
  .gift {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .capital,
  .base {
    display: block;
    width: 100%;
    height: 22px;
    background: linear-gradient(180deg, #fbf7ee, #d9cfbb);
    border: 1px solid #b5a688;
  }
  .capital {
    border-radius: 4px 4px 0 0;
    box-shadow: 0 8px 0 -2px #ece4d3;
  }
  .base {
    height: 18px;
  }
  .shaft {
    width: 88%;
    flex: 1;
    padding: 36px 26px;
    text-align: center;
    background:
      repeating-linear-gradient(90deg, rgba(160, 145, 115, 0.12) 0 2px, transparent 2px 22px),
      linear-gradient(90deg, #e3d9c4, #fbf7ee 35%, #ece3d0 70%, #d2c6ad);
    border-inline: 1px solid #c3b597;
