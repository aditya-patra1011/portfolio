---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, skills, earlyWork } from "../data/site";
---

<BaseLayout title="About" description={`About ${site.name}: education, skills and how I work.`}>
  <section class="wrap head">
    <p class="eyebrow">cat about.md</p>
    <h1>{site.name}<span class="caret" aria-hidden="true"></span></h1>
  </section>

  <section class="wrap layout">
    <div class="prose">
      <!-- TODO: rewrite in your own voice. Keep it short: who you are, what you like building, what you want next. -->
      <p>
        I'm a {site.education.note} {site.education.degree} student at {site.education.school}. I like
        projects where the data is real and messy and the question is concrete: which tyre should this
        driver pit for, which Kepler signals are actually planets, which two satellites are about to get too close.
      </p>
      <p>
        I care about the parts of ML that are easy to skip: honest validation splits, checking where a
        model's accuracy really comes from, and packaging the result so someone else can run it.
      </p>

      <h2>What I'm looking for</h2>
      <p>Internships and graduate roles in machine learning engineering or data science.</p>

      <h2>Early work</h2>
      <p>First-year coursework in Java, kept for the record:</p>
      <ul>
        {
          earlyWork.map((w) => (
            <li>
              <a href={w.repo}>{w.name}</a> <span class="mono">({w.stack})</span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="side">
      <div class="panel box">
        <p class="mono file"># education</p>
        <p><strong>{site.education.degree}</strong><br /><span class="dim">{site.education.school}</span></p>
      </div>
      <div class="panel box">
        <p class="mono file"># skills</p>
        <dl>
          {
            skills.map((s) => (
              <div>
                <dt>{s.group.toLowerCase()}</dt>
                <dd>{s.items.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="links">
        <a class="btn primary" href={site.links.resume}>resume.pdf</a>
        <a class="btn" href={site.links.linkedin}>linkedin</a>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 96px) 32px;
  }
  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    margin-top: 12px;
    letter-spacing: -0.035em;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: clamp(32px, 6vw, 80px);
    padding-bottom: clamp(56px, 9vw, 112px);
    align-items: start;
  }
  .side {
    display: grid;
    gap: 18px;
  }
  .box {
    padding: 18px;
  }
  .box p {
    margin: 0 0 10px;
  }
  .file {
    color: var(--ink-3);
  }
  .dim {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  dl {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  dt {
    color: var(--cyan);
    font-size: 0.8rem;
  }
  dt::after {
    content: ":";
  }
  dd {
    margin: 2px 0 0;
    color: var(--ink-2);
    font-size: 0.86rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
