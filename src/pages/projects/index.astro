---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import SectionHead from "../../components/SectionHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
const domains = [...new Set(projects.flatMap((p) => p.data.domains))].sort();
---

<BaseLayout title="Projects" description="Machine-learning and data projects by M. Aditya Patra.">
  <PageBanner title="Portfolio" crumbs={[{ label: "Home", href: "/" }, { label: "Projects" }]} />

  <section class="section">
    <div class="wrap">
      <SectionHead
        eyebrow="All work"
        ghost="Projects"
        title={`${projects.length} projects so far`}
        accent="projects"
        intro="Filter by area. Each card opens a write-up covering the problem, the data, what I tried, and what I'd change."
      />

      <div class="filters" role="group" aria-label="Filter by area">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {domains.map((d) => <button type="button" data-filter={d} aria-pressed="false">{d}</button>)}
      </div>

      <div class="grid">
        {
          projects.map((p) => (
            <div class="item" data-domains={p.data.domains.join("|")}>
              <ProjectCard project={p} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>(".item");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      items.forEach((el) => {
        el.hidden = f !== "all" && !el.dataset.domains!.split("|").includes(f);
        // cards hidden at load never got their reveal; show them straight away
        el.querySelector("[data-reveal]")?.classList.add("in");
      });
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .filters button {
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 8px 18px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--card);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
  }
  .filters button:hover {
    border-color: var(--green);
    color: #fff;
  }
  .filters button[aria-pressed="true"] {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .item {
    display: flex;
  }
  .item > :global(*) {
    flex: 1;
  }
  .item[hidden] {
    display: none;
  }
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
