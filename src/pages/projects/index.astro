---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
const domains = [...new Set(projects.flatMap((p) => p.data.domains))].sort();
---

<BaseLayout title="Projects" description="Machine-learning and data projects by M. Aditya Patra.">
  <section class="wrap head">
    <p class="eyebrow">index</p>
    <h1>~/projects<span class="caret" aria-hidden="true"></span></h1>
    <p class="sub">
      <span class="neon" data-count>{projects.length}</span> entries. Each one has a write-up covering the problem, the data, what I tried, and what I'd change.
    </p>
    <div class="filters" role="group" aria-label="Filter by domain">
      <span class="mono label">--filter</span>
      <button type="button" data-filter="all" aria-pressed="true">all</button>
      {domains.map((d) => <button type="button" data-filter={d} aria-pressed="false">{d.toLowerCase()}</button>)}
    </div>
  </section>

  <section class="wrap grid-wrap">
    <div class="grid">
      {
        projects.map((p) => (
          <div class="item" data-domains={p.data.domains.join("|")}>
            <ProjectCard project={p} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>(".item");
  const count = document.querySelector<HTMLElement>("[data-count]");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      let shown = 0;
      items.forEach((el) => {
        el.hidden = f !== "all" && !el.dataset.domains!.split("|").includes(f);
        if (!el.hidden) shown++;
      });
      if (count) count.textContent = String(shown);
    }),
  );
</script>

<style>
  .head {
    padding-block: clamp(48px, 8vw, 96px) 32px;
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-top: 12px;
    letter-spacing: -0.03em;
  }
  .sub {
    color: var(--ink-2);
    max-width: 62ch;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
  }
  .label {
    color: var(--ink-3);
    margin-right: 4px;
  }
  .filters button {
    font: inherit;
    font-size: 0.78rem;
    padding: 4px 12px;
    border-radius: 2px;
    border: 1px solid var(--line-2);
    background: rgba(3, 6, 4, 0.6);
    color: var(--ink-2);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, box-shadow 0.15s;
  }
  .filters button:hover {
    border-color: var(--neon-dim);
    color: var(--ink);
  }
  .filters button[aria-pressed="true"] {
    background: var(--neon);
    border-color: var(--neon);
    color: var(--bg);
    font-weight: 700;
    box-shadow: var(--glow);
  }
  .grid-wrap {
    padding-bottom: clamp(56px, 9vw, 112px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
  .item {
    display: flex;
  }
  .item > :global(*) {
    flex: 1;
  }
  .item[hidden] {
    display: none;
  }
</style>
