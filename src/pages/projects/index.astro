---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleBanner from "../../components/TempleBanner.astro";
import ScrollCard from "../../components/ScrollCard.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
const domains = [...new Set(projects.flatMap((p) => p.data.domains))].sort();
---

<BaseLayout title="The Treasury" description="Machine-learning and data projects by M. Aditya Patra.">
  <TempleBanner title="The Treasury" greek="ΘΗΣΑΥΡΟΣ" />

  <section class="treasury">
    <div class="wrap">
      <p class="intro">{projects.length} scrolls are kept here. Choose a subject, then click a scroll to unroll it.</p>
      <div class="filters" role="group" aria-label="Filter by subject">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {domains.map((d) => <button type="button" data-filter={d} aria-pressed="false">{d}</button>)}
      </div>
      <div class="scrolls">
        {
          projects.map((p, i) => (
            <div class="item" data-domains={p.data.domains.join("|")}>
              <ScrollCard project={p} index={i} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLElement>(".item");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      items.forEach((el) => {
        el.hidden = f !== "all" && !el.dataset.domains!.split("|").includes(f);
        el.querySelector("[data-reveal]")?.classList.add("in");
      });
    }),
  );
</script>

<style>
  .treasury {
    padding-block: clamp(48px, 7vw, 80px) clamp(72px, 10vw, 120px);
  }
  .intro {
    text-align: center;
    font-size: 1.2rem;
    font-style: italic;
    margin: 0 0 24px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 48px;
  }
  .filters button {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 16px;
    border: 1px solid var(--parchment-dark);
    background: #fbf6ea;
    color: var(--ink-2);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .filters button:hover {
    border-color: var(--gold);
  }
  .filters button[aria-pressed="true"] {
    background: var(--aegean);
    border-color: var(--aegean);
    color: var(--gold-light);
  }
  .scrolls {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 34px;
    padding-inline: 10px;
  }
  .item {
    display: flex;
  }
  .item > :global(*) {
    flex: 1;
  }
  .item[hidden] {
    display: none;
  }
  @media (max-width: 1024px) {
    .scrolls {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .scrolls {
      grid-template-columns: 1fr;
    }
  }
</style>
