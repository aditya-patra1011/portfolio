---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleBanner from "../../components/TempleBanner.astro";
import ScrollContent from "../../components/ScrollContent.astro";
import { getProjects, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <TempleBanner title="A scroll from the treasury" greek="ΒΙΒΛΙΟΝ" back={{ label: "Back to the treasury", href: "/projects/" }} />

  <section class="page">
    <div class="scroll">
      <span class="rod" aria-hidden="true"></span>
      <article class="sheet">
        <ScrollContent project={project} />
      </article>
      <span class="rod" aria-hidden="true"></span>
    </div>

    <nav class="pager" aria-label="More scrolls">
      <a href={`/projects/${prev.id}/`}><span>‹ Previous scroll</span>{prev.data.title}</a>
      <a href={`/projects/${next.id}/`} class="next"><span>Next scroll ›</span>{next.data.title}</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .page {
    width: min(900px, 94vw);
    margin: 0 auto;
    padding-block: clamp(48px, 7vw, 80px) clamp(72px, 10vw, 110px);
  }
  .scroll {
    display: flex;
    flex-direction: column;
  }
  .rod {
    position: relative;
    z-index: 1;
    height: 26px;
    margin-inline: -14px;
    border-radius: 13px;
    background: linear-gradient(180deg, #b07c3e, #6e4317 55%, #3f240b);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
  }
  .rod::before,
  .rod::after {
    content: "";
    position: absolute;
    top: -6px;
    width: 20px;
    height: 38px;
    border-radius: 8px;
    background: linear-gradient(180deg, #f0cf7c, #9a6f22);
  }
  .rod::before {
    left: -14px;
  }
  .rod::after {
    right: -14px;
  }
  .sheet {
    margin-block: -8px;
    padding: clamp(40px, 6vw, 64px) clamp(20px, 6vw, 64px);
    background:
      linear-gradient(90deg, rgba(150, 105, 40, 0.22), transparent 6%, transparent 94%, rgba(150, 105, 40, 0.22)),
      var(--parchment);
    box-shadow: 0 20px 40px rgba(60, 40, 10, 0.2);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 56px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    color: var(--ink);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--terracotta);
  }
  .pager span {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .next {
    text-align: right;
    align-items: flex-end;
  }
</style>
