---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, summary, status, year, domains, stack, highlights, repo, demo, cover } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <article class="wrap">
    <header class="head">
      <a class="mono back" href="/projects/">cd ../projects</a>
      <p class="eyebrow">{domains.join(" / ").toLowerCase()} · {year}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </header>

    {
      cover && (
        <figure class="cover panel">
          <figcaption class="mono">preview.png</figcaption>
          <img src={cover} alt={`${title} screenshot`} />
        </figure>
      )
    }

    <div class="layout">
      <aside class="facts panel">
        <p class="mono file">$ cat meta.json</p>
        <dl>
          <div>
            <dt>status</dt>
            <dd><span class="status" data-status={status}>{status === "shipped" ? "SHIPPED" : "RUNNING"}</span></dd>
          </div>
          <div>
            <dt>stack</dt>
            <dd class="tags">{stack.map((s) => <span class="tag">{s}</span>)}</dd>
          </div>
          {
            highlights.length > 0 && (
              <div>
                <dt>highlights</dt>
                <dd>
                  <ul>
                    {highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
        <div class="links">
          <a class="btn" href={repo}>source</a>
          {demo && <a class="btn primary" href={demo}>live_demo</a>}
        </div>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="next panel" aria-label="Next project">
      <span class="mono dim">$ next</span>
      <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(40px, 7vw, 80px) 32px;
    max-width: 860px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    text-decoration: none;
    color: var(--ink-3);
  }
  .back::before {
    content: "$ ";
    color: var(--neon);
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-top: 12px;
    letter-spacing: -0.035em;
  }
  .summary {
    font-size: 1.05rem;
    color: var(--ink-2);
    margin: 18px 0 0;
  }
  .cover {
    margin: 0 0 40px;
    overflow: hidden;
  }
  figcaption {
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
  }
  .cover img {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    object-position: top;
  }
  .layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .facts {
    position: sticky;
    top: 82px;
    display: grid;
    gap: 20px;
    padding: 18px;
  }
  .file {
    margin: 0;
    color: var(--ink-3);
  }
  dl {
    display: grid;
    gap: 16px;
    margin: 0;
  }
  dt {
    color: var(--cyan);
    font-size: 0.78rem;
  }
  dt::after {
    content: ":";
  }
  dd {
    margin: 6px 0 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  dd ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--ink);
  }
  dd li::before {
    content: "▸ ";
    color: var(--neon);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block: clamp(56px, 9vw, 96px);
    padding: 22px 24px;
  }
  .dim {
    color: var(--ink-3);
  }
  .next a {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    font-weight: 700;
    text-decoration: none;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .facts {
      position: static;
    }
  }
</style>
