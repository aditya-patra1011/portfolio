---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, summary, status, year, domains, stack, highlights, repo, demo, cover } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <article class="wrap">
    <header class="head">
      <a class="mono back" href="/projects/">← All projects</a>
      <p class="eyebrow">{domains.join(" / ")} · {year}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </header>

    {cover && <img class="cover" src={cover} alt={`${title} screenshot`} />}

    <div class="layout">
      <aside class="facts">
        <dl>
          <div>
            <dt class="eyebrow">Status</dt>
            <dd><span class="status" data-status={status}>{status === "shipped" ? "Shipped" : "In progress"}</span></dd>
          </div>
          <div>
            <dt class="eyebrow">Stack</dt>
            <dd class="tags">{stack.map((s) => <span class="tag">{s}</span>)}</dd>
          </div>
          {
            highlights.length > 0 && (
              <div>
                <dt class="eyebrow">Highlights</dt>
                <dd>
                  <ul>
                    {highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
        <div class="links">
          <a class="btn" href={repo}>Source code</a>
          {demo && <a class="btn primary" href={demo}>Live demo</a>}
        </div>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="next" aria-label="Next project">
      <span class="eyebrow">Next project</span>
      <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(40px, 7vw, 80px) 32px;
    max-width: 820px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    text-decoration: none;
    color: var(--ink-3);
  }
  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    margin-top: 12px;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--ink-2);
    margin: 18px 0 0;
  }
  .cover {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .facts {
    position: sticky;
    top: 84px;
    display: grid;
    gap: 24px;
  }
  dl {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  dd {
    margin: 8px 0 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  dd ul {
    margin: 0;
    padding-left: 18px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block: clamp(56px, 9vw, 96px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .next a {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .facts {
      position: static;
    }
  }
</style>
