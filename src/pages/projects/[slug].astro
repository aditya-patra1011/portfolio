---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import { getProjects, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const { title, summary, status, year, domains, stack, highlights, repo, demo, cover } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <PageBanner
    title={title}
    crumbs={[{ label: "Home", href: "/" }, { label: "Projects", href: "/projects/" }, { label: title }]}
  />

  <section class="section">
    <div class="wrap">
      {cover && <img class="cover" src={cover} alt={`${title} screenshot`} />}

      <div class="layout">
        <article>
          <span class="eyebrow">{domains.join(" / ")}</span>
          <p class="lead-rule summary">{summary}</p>
          <div class="prose">
            <Content />
          </div>
        </article>

        <aside class="info">
          <h3>Project <span class="green">info</span></h3>
          <dl>
            <div>
              <dt>Status</dt>
              <dd><span class="status" data-status={status}>{status === "shipped" ? "Shipped" : "In progress"}</span></dd>
            </div>
            <div>
              <dt>Year</dt>
              <dd>{year}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd class="tags">{stack.map((s) => <span class="tag">{s}</span>)}</dd>
            </div>
          </dl>
          {
            highlights.length > 0 && (
              <ul class="highlights">
                {highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )
          }
          <div class="links">
            <a class="btn" href={repo}>Source code</a>
            {demo && <a class="btn ghost" href={demo}>Live demo</a>}
          </div>
        </aside>
      </div>

      <nav class="pager" aria-label="More projects">
        <a href={`/projects/${prev.id}/`} class="prev">
          <span>Previous</span>
          {prev.data.title}
        </a>
        <a href={`/projects/${next.id}/`} class="next">
          <span>Next</span>
          {next.data.title}
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .cover {
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    object-position: top;
    margin-bottom: clamp(40px, 6vw, 64px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 330px;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .summary {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .info {
    position: sticky;
    top: 104px;
    background: var(--card);
    padding: 30px 28px;
  }
  .info h3 {
    font-size: 1.5rem;
    margin-bottom: 20px;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  dd {
    margin: 4px 0 0;
    color: #fff;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .highlights {
    list-style: none;
    margin: 24px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 10px;
    font-size: 0.9rem;
  }
  .highlights li {
    position: relative;
    padding-left: 20px;
  }
  .highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 8px;
    background: var(--green);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    text-transform: uppercase;
    color: #fff;
  }
  .pager a:hover {
    color: var(--green);
  }
  .pager span {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--green);
  }
  .next {
    text-align: right;
    align-items: flex-end;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .info {
      position: static;
    }
  }
</style>
